<Window x:Class="WpfApp1.Win.RegistrationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1.Win"
        mc:Ignorable="d"
        Title="Регистрация сотрудника" Width="480" Height="677"
        Background="#F2F8F6">
    <Border Background="White" CornerRadius="12" Margin="22" Padding="24"
            BorderBrush="#D8E9E3" BorderThickness="1">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,0,0,-15">
            <StackPanel>
                <TextBlock Text="Регистрация" FontSize="23" FontWeight="Bold" Foreground="#268C7E"
                           Margin="0,0,0,18"/>
                <TextBlock Text="Фамилия"/>
                <TextBox x:Name="SurnameBox" Style="{StaticResource Input}" MaxLength="50"/>
                <TextBlock Text="Имя"/>
                <TextBox x:Name="NameBox" Style="{StaticResource Input}" MaxLength="50"/>
                <TextBlock Text="Отчество (необязательно)"/>
                <TextBox x:Name="MiddleBox" Style="{StaticResource Input}" MaxLength="50"/>
                <TextBlock Text="Телефон"/>
                <TextBox x:Name="PhoneBox" Style="{StaticResource Input}" MaxLength="20"/>
                <TextBlock Text="Логин"/>
                <TextBox x:Name="LoginBox" Style="{StaticResource Input}" MaxLength="50"/>
                <TextBlock Text="Пароль"/>
                <PasswordBox x:Name="PasswordInput" Style="{StaticResource PasswordInput}" MaxLength="50"/>
                <Button Content="Зарегистрироваться" Style="{StaticResource MainButton}"
                        Margin="0,8,0,5" Click="Save_Click"/>
                <Button Content="Отмена" Style="{StaticResource LightButton}" Click="Cancel_Click"/>
            </StackPanel>
        </ScrollViewer>
    </Border>
</Window>