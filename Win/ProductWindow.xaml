<Window x:Class="WpfApp1.Win.ProductWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1.Win"
        mc:Ignorable="d"
        Title="Препарат" Width="500" Height="620" ResizeMode="NoResize"
        Background="#F2F8F6">
    <Border Background="White" CornerRadius="12" Margin="22" Padding="22"
            BorderBrush="#D8E9E3" BorderThickness="1">
        <StackPanel>
            <TextBlock x:Name="TitleText" Text="Добавление препарата" FontSize="22" FontWeight="Bold"
                       Foreground="#268C7E" Margin="0,0,0,18"/>
            <TextBlock Text="Название"/>
            <TextBox x:Name="NameBox" Style="{StaticResource Input}" MaxLength="100"/>
            <TextBlock Text="Описание"/>
            <TextBox x:Name="DescriptionBox" Padding="7" Height="70" TextWrapping="Wrap"
                     AcceptsReturn="True" BorderBrush="#B5D2CB" MaxLength="255" Margin="0,3,0,11"/>
            <TextBlock Text="Цена (руб.)"/>
            <TextBox x:Name="PriceBox" Style="{StaticResource Input}"/>
            <TextBlock Text="Производитель"/>
            <ComboBox x:Name="ManufacturerBox" Height="34" Margin="0,3,0,11"
                      DisplayMemberPath="Nazvanie" SelectedValuePath="IdProizvoditelya"/>
            <TextBlock Text="Категория"/>
            <ComboBox x:Name="CategoryBox" Height="34" Margin="0,3,0,15"
                      DisplayMemberPath="NazvanieKategorii" SelectedValuePath="IdKategorii"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Сохранить" Style="{StaticResource MainButton}" Click="Save_Click"/>
                <Button Content="Отмена" Style="{StaticResource LightButton}" Click="Cancel_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
