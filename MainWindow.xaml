<Window x:Class="WpfApp1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid Margin="0,0,0,-6">
        <Border Background="White" CornerRadius="12" Padding="25"
                Margin="35,23,35,28" BorderBrush="#D8E9E3" BorderThickness="1">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="АПТЕКА" FontSize="26" FontWeight="Bold"
                           Foreground="#268C7E" HorizontalAlignment="Center"/>
                <TextBlock Text="Вход в систему" FontSize="15" Foreground="#62736F"
                           Margin="0,6,0,24" HorizontalAlignment="Center"/>
                <TextBlock Text="Логин"/>
                <TextBox x:Name="LoginBox" Style="{StaticResource Input}"/>
                <TextBlock Text="Пароль"/>
                <PasswordBox x:Name="PasswordInput" Style="{StaticResource PasswordInput}"/>
                <Button Content="Войти" Style="{StaticResource MainButton}"
                        Margin="0,12,0,4" Click="Login_Click"/>
                <Button Content="Регистрация" Style="{StaticResource LightButton}"
                        Click="Register_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
