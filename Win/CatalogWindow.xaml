<Window x:Class="WpfApp1.Win.CatalogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1.Win"
        mc:Ignorable="d"
        Title="Аптека — Каталог" Width="1080" Height="700" MinWidth="850" MinHeight="550"
        Background="#F2F8F6">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White"
                CornerRadius="9" Padding="12"
                Margin="0,0,0,12">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">

                    <TextBlock Text="АПТЕКА"
                               Foreground="#268C7E"
                               FontWeight="Bold"
                               FontSize="22"
                               VerticalAlignment="Center"
                               Margin="0,0,16,0"/>

                    <TextBlock x:Name="UserText"
                               VerticalAlignment="Center"
                               Foreground="#536763"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Right"
                            Orientation="Horizontal">
                    <Button Content="Продажи"
                            Style="{StaticResource LightButton}"
                            Click="Sales_Click"/>

                    <Button Content="Выйти"
                            Style="{StaticResource LightButton}"
                            Click="Logout_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Каталог -->
            <Border Grid.Column="0"
                    Background="White"
                    CornerRadius="9"
                    Padding="14"
                    Margin="0,0,12,0">

                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <DockPanel Margin="0,0,0,9"
                                   LastChildFill="False">
                            <TextBlock Text="Каталог препаратов"
                                       FontSize="20"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       DockPanel.Dock="Left"/>

                            <StackPanel x:Name="AdminPanel"
                                        DockPanel.Dock="Right"
                                        Orientation="Horizontal"
                                        Visibility="Collapsed">

                                <Button Content="Добавить препарат"
                                        Style="{StaticResource MainButton}"
                                        DockPanel.Dock="Right"
                                        Click="AddProduct_Click"/>
                            </StackPanel>
                        </DockPanel>

                        <TextBox x:Name="SearchBox"
                                 Style="{StaticResource Input}"
                                 MaxLength="100"
                                 ToolTip="Поиск по названию"
                                 TextChanged="SearchBox_TextChanged"/>
                    </StackPanel>

                    <ListBox x:Name="ProductsList"
                             BorderThickness="0"
                             Background="Transparent"
                             HorizontalContentAlignment="Stretch">

                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment"
                                        Value="Stretch"/>
                                <Setter Property="Padding" Value="0"/>
                            </Style>
                        </ListBox.ItemContainerStyle>

                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#F9FCFB"
                                        BorderBrush="#DBEAE5"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="12"
                                        Margin="1,5"
                                        HorizontalAlignment="Stretch">

                                    <StackPanel>
                                        <!-- Название и цена -->
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding Nazvanie}"
                                                       FontSize="17"
                                                       FontWeight="SemiBold"
                                                       Foreground="#233D37"
                                                       VerticalAlignment="Center"
                                                       TextWrapping="Wrap"
                                                       Margin="0,0,15,0"/>

                                            <StackPanel Grid.Column="1"
                                                        Orientation="Horizontal"
                                                        VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Cena, StringFormat={}{0:N2}}"
                                                           FontWeight="Bold"
                                                           FontSize="16"
                                                           Foreground="#268C7E"/>

                                                <TextBlock Text=" руб."
                                                           FontWeight="Bold"
                                                           FontSize="16"
                                                           Foreground="#268C7E"/>
                                            </StackPanel>
                                        </Grid>

                                        <TextBlock Text="{Binding Opisanie}"
                                                   Foreground="#566762"
                                                   TextWrapping="Wrap"
                                                   Margin="0,0,0,8"/>

                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Производитель: "
                                                       Foreground="#6A7874"/>
                                            <TextBlock Text="{Binding Proizvoditel}"/>
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal"
                                                    Margin="0,3,0,7">
                                            <TextBlock Text="Категория: "
                                                       Foreground="#6A7874"/>
                                            <TextBlock Text="{Binding Kategoriya}"/>
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="В корзину"
                                                    Tag="{Binding IdPreparata}"
                                                    Click="AddCart_Click"
                                                    Style="{StaticResource MainButton}"/>

                                            <Button Content="Изменить"
                                                    Tag="{Binding IdPreparata}"
                                                    Visibility="{Binding DataContext.AdminVisibility, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    Click="EditProduct_Click"
                                                    Style="{StaticResource LightButton}"/>

                                            <Button Content="Удалить"
                                                    Tag="{Binding IdPreparata}"
                                                    Visibility="{Binding DataContext.AdminVisibility, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    Click="DeleteProduct_Click"
                                                    Style="{StaticResource LightButton}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- Корзина -->
            <Border Grid.Column="1"
                    Background="White"
                    CornerRadius="9"
                    Padding="14">

                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="Корзина"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,5"/>

                        <TextBlock Text="Выберите препараты из каталога"
                                   Foreground="#667873"
                                   Margin="0,0,0,12"/>
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Bottom"
                                Margin="0,12,0,0">

                        <Button Content="Убрать выбранное"
                                Style="{StaticResource LightButton}"
                                Click="RemoveCart_Click"/>

                        <TextBlock x:Name="TotalText"
                                   Text="Итого: 0 руб."
                                   FontSize="18"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Right"
                                   Margin="0,12,3,8"/>

                        <Button Content="Оформить продажу"
                                Style="{StaticResource MainButton}"
                                Click="Checkout_Click"/>
                    </StackPanel>

                    <DataGrid x:Name="CartGrid"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              HeadersVisibility="Column"
                              RowHeaderWidth="0"
                              GridLinesVisibility="Horizontal"
                              BorderBrush="#E1EAE6">

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Препарат"
                                                Binding="{Binding Nazvanie}"
                                                Width="*"/>

                            <DataGridTextColumn Header="Кол."
                                                Binding="{Binding Kolichestvo}"
                                                Width="45"/>

                            <DataGridTextColumn Header="Сумма"
                                                Binding="{Binding Summa, StringFormat={}{0:N2}}"
                                                Width="75"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>