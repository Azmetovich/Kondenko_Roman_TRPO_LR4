<Window x:Class="WpfApp1.Win.SalesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1.Win"
        mc:Ignorable="d"
        Title="История продаж" Width="940" Height="540" MinWidth="790" MinHeight="430"
        Background="#F2F8F6">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="История продаж"
                       FontSize="23"
                       FontWeight="Bold"
                       Foreground="#268C7E"
                       VerticalAlignment="Center"/>

            <Button Content="Обновить"
                    Style="{StaticResource LightButton}"
                    DockPanel.Dock="Right"
                    Click="Refresh_Click"/>
        </DockPanel>

        <DataGrid x:Name="SalesGrid"
                  Grid.Row="1"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  RowHeaderWidth="0"
                  BorderBrush="#D8E9E3">

            <DataGrid.Columns>
                <DataGridTextColumn Header="№"
                                    Binding="{Binding IdProdazhi}"
                                    Width="45"/>

                <DataGridTextColumn Header="Препарат"
                                    Binding="{Binding Preparat}"
                                    Width="*"/>

                <DataGridTextColumn Header="Сотрудник"
                                    Binding="{Binding Sotrudnik}"
                                    Width="*"/>

                <DataGridTextColumn Header="Дата"
                                    Binding="{Binding DataProdazhi, StringFormat={}{0:dd.MM.yyyy HH:mm}}"
                                    Width="135"/>

                <DataGridTextColumn Header="Кол."
                                    Binding="{Binding Kolichestvo}"
                                    Width="55"/>

                <DataGridTextColumn Header="Цена"
                                    Binding="{Binding CenaProdazhi, StringFormat={}{0:N2}}"
                                    Width="75"/>

                <DataGridTextColumn Header="Сумма"
                                    Binding="{Binding Summa, StringFormat={}{0:N2}}"
                                    Width="85"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>